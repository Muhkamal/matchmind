# MatchMind environment template. Copy to .env and fill in locally.
# NEVER commit .env, NEVER paste it into a chat or an issue. If a real key ever leaves your machine, rotate it.

# football-data.org (free tier, 10 requests/minute): https://www.football-data.org/client/register
FOOTBALL_DATA_ORG_KEY=

# Supabase "Session pooler" or "Transaction pooler" string (Project Settings > Database > Connection string).
# Use the POOLER host (…pooler.supabase.com), NOT the direct db.<ref>.supabase.co host (IPv6-only; GitHub Actions can't reach it).
# The username for a pooler has the form  <role>.<project-ref>
#
# 1) Owner role: used ONLY by nightly.py / backfill.py / settle.py (writes the ledger)
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
# 2) Read-only role for the public API (migration-2026-11-06.sql creates matchmind_ro; you set its password)
API_DATABASE_URL=postgresql://matchmind_ro.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
# 3) Bot role: can only write arena tables (matchmind_bot)
BOT_DATABASE_URL=postgresql://matchmind_bot.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres

# Telegram bot token from @BotFather (bot.py only)
TELEGRAM_BOT_TOKEN=

# Optional: LLM rephrase for /explain (blank = free template; output is validated, numbers can't change)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Leagues the registry supports (src/teams.py). Only E0 today.
LEAGUES=E0
